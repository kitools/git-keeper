{
  "name": "git-keeper",
  "version": "0.1.0",
  "description": "Manage Git repository files — safely delete tracked files, list untracked files, scan multi-repo workspaces",
  "type": "module",
  "bin": {
    "git-keeper": "dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc",
    "dev": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check src/",
    "format": "biome check --write src/"
  },
  "keywords": ["git", "cli", "clean", "untracked"],
  "license": "MIT",
  "packageManager": "pnpm@10.33.1",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "es-toolkit": "^1.37.0",
    "execa": "^9.5.2",
    "ink": "^7.0.4",
    "ink-text-input": "^6.0.0",
    "react": "^19.2.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.2.15",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3"
  }
}
